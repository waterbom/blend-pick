{
  "name": "blend-pick",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:monitor": "node --test tests/storefront-monitor.cjs tests/traffic.cjs",
    "test:visits": "node --test tests/visit-analytics.cjs tests/visit-analytics-db.cjs tests/prepare-visit-analytics.cjs",
    "test:traffic-live": "node --test tests/traffic-live.cjs",
    "check:monitoring": "npm run test:monitor && npm run test:visits && npm run test:traffic-live && npm run build",
    "test:secret-links": "node --test tests/secret-link-periods.cjs",
    "test:admin-integrity": "node --test --test-concurrency=1 tests/admin-auth.cjs tests/today-work.cjs tests/secret-link-periods.cjs tests/admin-integrity.cjs tests/admin-process-review.cjs tests/admin-final-process.cjs",
    "test:admin-final": "node --test tests/admin-final-process.cjs"
  },
  "dependencies": {
    "@tosspayments/tosspayments-sdk": "^2.6.0",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "jose": "^6.2.2",
    "jsonwebtoken": "^9.0.3",
    "next": "16.2.2",
    "nodemailer": "^8.0.5",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
