# 환경변수 예시 — 실제 값은 .env.local 에 (git에 올리지 말 것)

# ── DB ──────────────────────────────────────────────
# 상용(EC2):  blendpunch_dev / blendpunch_shop
# 개발(로컬): blendpunch_os_dev / blendpunch_shop_dev
# 자세한 내용: docs/db-environments.md
DATABASE_URL=postgresql://USER:PASSWORD@blendpunch-db.ctikyeuwquey.ap-northeast-2.rds.amazonaws.com:5432/blendpunch_os_dev
SHOP_DATABASE_URL=postgresql://USER:PASSWORD@blendpunch-db.ctikyeuwquey.ap-northeast-2.rds.amazonaws.com:5432/blendpunch_shop_dev

# ── 기타 ────────────────────────────────────────────
# SWEETTRACKER_API_KEY=   # 배송 추적 — 스마트택배(sweettracker) API 키. 미설정 시 배송추적/자동 배송완료 비활성

# ── 방문 통계: 기본 비활성, 운영 반영과 별개로 활성화 ──
ANALYTICS_ENABLED=false
# 전용 통계 저장소. 기존 주문 DB로 자동 연결하지 않음.
ANALYTICS_DATABASE_URL=
# 별도 무작위 키 32자 이상. 기존 로그인/결제 키를 재사용하지 않음.
ANALYTICS_HASH_SECRET=
