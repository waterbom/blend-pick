# 환경변수 예시 — 실제 값은 .env.local 에 (git에 올리지 말 것)

# ── DB ──────────────────────────────────────────────
# 상용(EC2):  blendpunch_dev / blendpunch_shop
# 개발(로컬): blendpunch_os_dev / blendpunch_shop_dev
# 자세한 내용: docs/db-environments.md
DATABASE_URL=postgresql://USER:PASSWORD@blendpunch-db.ctikyeuwquey.ap-northeast-2.rds.amazonaws.com:5432/blendpunch_os_dev
SHOP_DATABASE_URL=postgresql://USER:PASSWORD@blendpunch-db.ctikyeuwquey.ap-northeast-2.rds.amazonaws.com:5432/blendpunch_shop_dev

# ── 기타 ────────────────────────────────────────────
# SWEETTRACKER_API_KEY=   # 배송 추적 — 스마트택배(sweettracker) API 키. 미설정 시 배송추적/자동 배송완료 비활성

# ── 방문 통계: 기본 비활성, 운영 반영과 별개로 활성화 ──
ANALYTICS_ENABLED=false
# 전용 통계 저장소. 기존 주문 DB로 자동 연결하지 않음.
ANALYTICS_DATABASE_URL=
# 별도 무작위 키 32자 이상. 기존 로그인/결제 키를 재사용하지 않음.
ANALYTICS_HASH_SECRET=

# ── 고객 편의·외부 연동: docs/customer-convenience.md ──
# 실제 Secret은 서버 환경변수에만 등록. 빈 설정은 비활성.
COMMERCE_ALIMTALK_ENABLED=false
COMMERCE_SMS_FALLBACK=false
# 기존 SOLAPI_API_KEY, SOLAPI_API_SECRET, SOLAPI_SENDER 재사용 가능
BLENDPICK_SOLAPI_PFID=
SANJIPICK_SOLAPI_PFID=
# 각 브랜드에서 승인받은 템플릿 ID만 입력
BLENDPICK_ALIMTALK_PAID_TEMPLATE=
BLENDPICK_ALIMTALK_SHIPPING_TEMPLATE=
BLENDPICK_ALIMTALK_REFUND_TEMPLATE=
BLENDPICK_ALIMTALK_DELAY_TEMPLATE=
BLENDPICK_ALIMTALK_RESTOCK_TEMPLATE=
BLENDPICK_ALIMTALK_OPENING_TEMPLATE=
SANJIPICK_ALIMTALK_PAID_TEMPLATE=
SANJIPICK_ALIMTALK_SHIPPING_TEMPLATE=
SANJIPICK_ALIMTALK_REFUND_TEMPLATE=
SANJIPICK_ALIMTALK_DELAY_TEMPLATE=
SANJIPICK_ALIMTALK_RESTOCK_TEMPLATE=
SANJIPICK_ALIMTALK_OPENING_TEMPLATE=
BLENDPICK_CHANNEL_PLUGIN_KEY=
BLENDPICK_CHANNEL_MEMBER_HASH_SECRET=
SANJIPICK_CHANNEL_PLUGIN_KEY=
SANJIPICK_CHANNEL_MEMBER_HASH_SECRET=
# 식품안전나라 I0580 활용 신청을 완료한 인증키
HACCP_SERVICE_KEY=
# 현재 가맹점 계약이 활성화된 결제수단만 지정: TOSSPAY,NAVERPAY,KAKAOPAY
BLENDPICK_TOSS_EASY_PAY=
SANJIPICK_TOSS_EASY_PAY=
# 카카오 콘솔에 승인된 서비스 약관 태그 목록. 모르면 비워 두기.
BLENDPICK_KAKAO_SYNC_TERMS=
SANJIPICK_KAKAO_SYNC_TERMS=
