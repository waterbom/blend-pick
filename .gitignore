# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# 학습노트
학습노트*.py
학습노트*.pdf

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 주문 초기화 백업 (고객정보 포함, 커밋 금지)
scripts/backup-orders-*.json

# 인플루언서 민감 서류 (public 밖, 절대 커밋 금지)
private-uploads/

# 고객 업로드 파일 (리뷰·교환반품 사진 — 런타임 생성, 커밋 금지)
/public/uploads/
